*.tgz
*.zip
*.7z
*.rar

# Explicitly reviewed SameBoy-source boot binaries, not Nintendo dumps.
!/src/saturn/bootroms/dmg_boot.bin
!/src/saturn/bootroms/cgb_boot_fast.bin

# Upstream build products, nested metadata and withheld references.
