# Generated outputs, installed SDK and publication staging.
# knovGBC source ignore correction dated 2026-10-10: retain only reviewed
# libYaul build templates and exclude the compiled poneSound srcs image.
/build/
/dist/
/tmp/
/toolchain/
/publication/
/.toolchain-src/
/tools/tests/picogb_build/
/.app-build.*
/.toolchain-build.*
/.yaul-build.*

# Private cartridges and save data.
/roms/**
!/roms/.gitkeep
*.gb
*.gbc
*.gba
*.nds
*.sfc
*.smc
*.nes
*.sav
*.srm

