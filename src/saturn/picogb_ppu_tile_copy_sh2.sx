/*
 * SH-2 RGB1555 tile-line blitter.
 *
 * r4 = destination (eight 16-bit pixels)
 * r5 = source      (eight 16-bit pixels, 4-byte aligned)
 *
 * The visible framebuffer begins at an SCX-dependent pixel offset. It is
 * therefore only guaranteed to be word-aligned. The common aligned path
 * uses four longword moves; the other path remains safe by using word moves.
 */
.section .text, "ax"
.align 2
.global _picogb_sh2_store_tile8
.type _picogb_sh2_store_tile8, @function

_picogb_sh2_store_tile8:
        mov     r4, r0
        tst     #2, r0
        bf      .L_word_copy
        nop

        mov.l   @r5+, r0
        mov.l   r0, @r4
        add     #4, r4
        mov.l   @r5+, r0
        mov.l   r0, @r4
        add     #4, r4
        mov.l   @r5+, r0
        mov.l   r0, @r4
        add     #4, r4
        mov.l   @r5+, r0
        mov.l   r0, @r4
        rts
        nop

.L_word_copy:
        mov.w   @r5+, r0
        mov.w   r0, @r4
        add     #2, r4
        mov.w   @r5+, r0
        mov.w   r0, @r4
        add     #2, r4
        mov.w   @r5+, r0
        mov.w   r0, @r4
        add     #2, r4
        mov.w   @r5+, r0
        mov.w   r0, @r4
        add     #2, r4
        mov.w   @r5+, r0
        mov.w   r0, @r4
        add     #2, r4
        mov.w   @r5+, r0
        mov.w   r0, @r4
        add     #2, r4
        mov.w   @r5+, r0
        mov.w   r0, @r4
        add     #2, r4
        mov.w   @r5+, r0
        mov.w   r0, @r4
        rts
        nop
.size _picogb_sh2_store_tile8, . - _picogb_sh2_store_tile8
